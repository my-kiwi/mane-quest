{
  "name": "mane-quest",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && npm run lint:fix && npm run test && vite build && rm -rf ./dist.zip && zip -r -9 dist.zip dist/ && ls -l | grep dist",
    "preview": "vite preview",
    "lint": "eslint ./src --ext .ts,.tsx",
    "lint:fix": "npm run lint -- --fix",
    "analyse:bundle": "npx vite-bundle-analyzer",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepare": "husky"
  },
  "devDependencies": {
    "@eslint/js": "^9.35.0",
    "@types/node": "^22",
    "@typescript-eslint/eslint-plugin": "^8.44.0",
    "@typescript-eslint/parser": "^8.44.0",
    "eslint": "^9.35.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "globals": "^16.4.0",
    "husky": "^9.1.7",
    "js13k-vite-plugins": "^1.0.4",
    "jsdom": "^26.1.0",
    "prettier": "^3.6.2",
    "terser": "^5.51.2",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.44.0",
    "vite": "^8",
    "vitest": "^5.0.0"
  }
}
